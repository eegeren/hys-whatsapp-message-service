# Copy the backend's DB/Redis/Meta configuration privately in Railway; no public URL.
APP_ENVIRONMENT=production
DATABASE_URL=${{Postgres.DATABASE_URL}}
REDIS_URL=${{Redis.REDIS_URL}}
DRY_RUN=true
LIVE_SEND_ENABLED=false
DEPLOYMENT_SEND_LOCK=true
BULK_DISPATCH_ENABLED=false
LOCAL_WORKER=false
BULK_DAILY_LIMIT=10000
META_ENVIRONMENT=production
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=1353767504488829
META_WABA_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v25.0
META_TEST_MESSAGE_ENABLED=false
